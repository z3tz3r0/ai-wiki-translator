# ai-wiki-translator · environment variables
# Copy to `.env` (gitignored) and fill in your values. The CLI auto-loads this
# file at startup; explicit shell-exported env vars take precedence.

# --- Required for live translation ----------------------------------------

# Gemini API key · https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# GCP project that hosts the Cloud Translate v3 API
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Path to a service-account JSON key with the Cloud Translate API role
# (Application Default Credentials path · auto-picked by the GCP SDK).
# Alternative: run `gcloud auth application-default login` and leave this unset.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Optional overrides ----------------------------------------------------

# Gemini model id (default: gemini-2.0-flash)
# WIKI_TRANSLATOR_GEMINI_MODEL=gemini-2.0-flash

# Cloud Translate region (default: global)
# WIKI_TRANSLATOR_GOOGLE_TRANSLATE_LOCATION=global

# User-Agent string sent to MediaWiki / Wikidata APIs.
# Defaults to `ai-wiki-translator/0.1 (https://github.com/z3tz3r0/ai-wiki-translator)`.
# WIKI_TRANSLATOR_USER_AGENT=your-app/0.1 (contact-info)

# Where draft files land. Default: ~/Documents/wiki-translations
# WIKI_TRANSLATOR_OUTPUT_DIR=/absolute/path/to/output

# Override the prompts directory. Default: app/prompts shipped with the package.
# WIKI_TRANSLATOR_PROMPTS_DIR=/absolute/path/to/prompts
