# ai-wiki-translator · environment variables
# Copy to `.env` (gitignored) and fill in your values. The CLI auto-loads this
# file at startup; explicit shell-exported env vars take precedence.

# --- Required ---------------------------------------------------------------

# Gemini API key(s) · https://aistudio.google.com/app/apikey
# Free-tier quota is counted per Google Cloud project, not per key, so extra
# keys add capacity only when each comes from its own project (AI Studio's
# API keys page shows the project). The CLI rotates keys per call, rests a key
# after a 429 (until midnight Pacific for a daily-quota 429) and drops a key
# that Google rejects as invalid.
#
# Set EITHER `GEMINI_API_KEYS` (preferred · comma-separated):
GEMINI_API_KEYS=key1,key2,key3
#
# OR a single `GEMINI_API_KEY`:
# GEMINI_API_KEY=your-gemini-api-key

# Term-level machine translation goes through Wikimedia MinT
# (https://translate.wmcloud.org) · free, no auth, no billing required.

# --- Optional overrides ----------------------------------------------------

# Gemini model id (default: gemini-flash-lite-latest · Google's alias, moves to
# each new Flash-Lite release with 2 weeks' notice by email). Pin a version if
# you want translation output to stay stable between runs:
# WIKI_TRANSLATOR_GEMINI_MODEL=gemini-3.5-flash-lite

# Self-consistency sampling · per-section the LLM is called this many times
# in parallel and the candidate with best structural fidelity (preserves
# [[REF_n]] markers, length close to median) wins. Default 3 lifts chrF by
# ~1-3 points on long articles at linear quota cost. Set to 1 to disable.
# WIKI_TRANSLATOR_LLM_SAMPLES=3

# User-Agent string sent to MediaWiki, Wikidata, and MinT APIs.
# Defaults to `ai-wiki-translator/0.1 (https://github.com/z3tz3r0/ai-wiki-translator)`.
# WIKI_TRANSLATOR_USER_AGENT=your-app/0.1 (contact-info)

# Where draft files land. Default: ~/Documents/wiki-translations
# WIKI_TRANSLATOR_OUTPUT_DIR=/absolute/path/to/output

# Override the prompts directory. Default: app/prompts shipped with the package.
# WIKI_TRANSLATOR_PROMPTS_DIR=/absolute/path/to/prompts
